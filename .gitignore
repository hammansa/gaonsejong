# Ignore development preview utilities in production
/dev/

# Node modules and lock
node_modules/
package-lock.json

# Python virtual envs
venv/
__pycache__/

# local env / API keys
GEMINI_API_KEY.env
.env
.env.*
.env.local

# Do not commit built deploy output (optionally generated locally)
deploy/netlify/
deploy/github/

